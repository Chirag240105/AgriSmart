# Copy this to .env and fill in your values

PORT=1212
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/agrismart

JWT_SECRET_KEY=your_long_random_secret_here
ACCESS_TOKEN_SECRET=your_long_random_secret_here

OPENWEATHER_API_KEY=your_openweather_key_here
GROQ_API_KEY=your_groq_key_here

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

ML_SERVER_URL=http://localhost:5001
FRONTEND_URL=https://your-app.vercel.app

PRICE_STREAM_INTERVAL_MS=30000
